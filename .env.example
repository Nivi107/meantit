# Copy to .env and fill in. Never commit .env.

PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Sandbox REST app for PayMart (the marketplace; Vault turned on)
PAYPAL_PAYMART_CLIENT_ID=
PAYPAL_PAYMART_SECRET=
PAYPAL_PAYMART_WEBHOOK_ID=

# Sandbox REST app for the Protection Fund (Payouts turned on)
PAYPAL_FUND_CLIENT_ID=
PAYPAL_FUND_SECRET=
PAYPAL_FUND_WEBHOOK_ID=

# Sandbox Demo Shopper login (for approving the first payment)
SANDBOX_SHOPPER_EMAIL=
SANDBOX_SHOPPER_PASSWORD=

# Neon Postgres connection string
DATABASE_URL=

# Claude API
ANTHROPIC_API_KEY=

# Deployed frontend URL (for CORS). Not needed locally.
FRONTEND_URL=
